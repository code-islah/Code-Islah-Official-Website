ing: 20px;\r\n            border-radius: 10px;\r\n            margin: 20px 0;\r\n            font-family: monospace;\r\n            overflow-x: auto;\r\n            line-height: 1.5;\r\n            font-size: 1rem;\r\n        }\r\n        \r\n        .key-points {\r\n            background: #e9f5ff;\r\n            padding: 20px;\r\n            border-radius: 10px;\r\n            margin: 20px 0;\r\n        }\r\n        \r\n        ul {\r\n            margin-left: 20px;\r\n            margin-bottom: 20px;\r\n        }\r\n        \r\n        li {\r\n            margin-bottom: 10px;\r\n            line-height: 1.5;\r\n        }\r\n        \r\n        footer {\r\n            text-align: center;\r\n            padding: 30px;\r\n            margin-top: 50px;\r\n            background: rgba(255, 255, 255, 0.9);\r\n            border-radius: 15px;\r\n        }\r\n        \r\n        @media (max-width: 900px) {\r\n            .content {\r\n                flex-direction: column;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"container\">\r\n        <header>\r\n            <h1>Flexbox Order Property</h1>\r\n            <p>Control the visual order of flex items without changing the HTML structure</p>\r\n        </header>\r\n        \r\n        <div class=\"content\">\r\n            <div class=\"explanation\">\r\n                <h2>Do you need to specify order for all items?</h2>\r\n                <p><strong>No, you don't need to specify order for all flex items.</strong> The order property only needs to be applied to items you want to reposition.</p>\r\n                \r\n                <div class=\"key-points\">\r\n                    <h3>Key Points:</h3>\r\n                    <ul>\r\n                        <li>All flex items have a default order value of <strong>0</strong></li>\r\n                        <li>Items with the same order value appear in the source order</li>\r\n                        <li>Items with lower order values