click=\"resetOrder()\">Reset All Orders</button>\r\n                </div>\r\n                \r\n                <div class=\"code-example\" id=\"codeOutput\">\r\n                    /* Current order values */\r\n                    .item-1 { order: 0; }\r\n                    .item-2 { order: 0; }\r\n                    .item-3 { order: 0; }\r\n                    .item-4 { order: 0; }\r\n                    .item-5 { order: 0; }\r\n                </div>\r\n            </div>\r\n        </div>\r\n        \r\n        <footer>\r\n            <p>Flexbox Order Property Demo &copy; 2023</p>\r\n        </footer>\r\n    </div>\r\n\r\n    <script>\r\n        function applyOrder(preset) {\r\n            const items = document.querySelectorAll('.item');\r\n            const codeOutput = document.getElementById('codeOutput');\r\n            \r\n            switch(preset) {\r\n                case 1: // Move Item 1 to End\r\n                    items[0].style.order = '5';\r\n                    items[0].textContent = 'Item 1 (order: 5)';\r\n                    updateCodeOutput();\r\n                    break;\r\n                    \r\n                case 2: // Move Item 5 to Start\r\n                    items[4].style.order = '-1';\r\n                    items[4].textContent = 'Item 5 (order: -1)';\r\n                    updateCodeOutput();\r\n                    break;\r\n                    \r\n                case 3: // Reverse Order\r\n                    items[0].style.order = '5';\r\n                    items[1].style.order = '4';\r\n                    items[2].style.order = '3';\r\n                    items[3].style.order = '2';\r\n                    items[4].style.order = '1';\r\n                    \r\n                    items[0].textContent = 'Item 1 (order: 5)';\r\n                    items[1].textContent = 'Item 2 (order: 4)';\r\n                    items[2].textContent = 'Item 3 (order: 3)';\r\n                    items[3].textContent = 'Item 4 (order: 2)';\r\n                    items[4].textContent = 'Item 5 (order: 1)';\r\n                    \r\n                    updateCodeOutput();\r\n                    break;\r\n                    \r\n                case 4: // Custom Order\r\n                    items[0].style.order = '3';\r\n                    items[1].style.order = '1';\r\n                    items[2].style.order = '4';\r\n                    items[3].style.order = '2';\r\n                    items[4].style.order = '5';\r\n                    \r\n                    items[0].textContent = 'Item 1 (order: 3)';\r\n                    items[1].textContent = 'Item 2 (order: 1)';\r\n                    items[2].textContent = 'Item 3 (order: 4)';\r\n                    items[3].textContent = 'Item 4 (order: 2)';\r\n                    items[4].textContent = 'Item 5 (order: 5)';\r\n                    \r\n                    updateCodeOutput();\r\n                    break;\r\n            }\r\n            \r\n            function updateCodeOutput() {\r\n                let codeText = '/* Current order values */\\n';\r\n                items.forEach((item, index) => {\r\n                    const orderValue = item.style.order || '0';\r\n                    codeText += `.item-${index+1} { order: ${orderValue}; }\\n`;\r\n                });\r\n                codeOutput.textContent = codeText;\r\n            }\r\n        }\r\n        \r\n        function resetOrder() {\r\n            const items = document.querySelectorAll('.item');\r\n            const codeOutput = document.getElementById('codeOutput');\r\n            \r\n            items.forEach((item, index) => {\r\n                item.style.order = '0';\r\n                item.textContent = `Item ${index+1} (order: 0)`;\r\n            });\r\n            \r\n            codeOutput.textContent = `/* Current order values */\\n.item-1 { order: 0; }\\n.item-2 { order: 0; }\\n.item-3 { order: 0; }\\n.item-4 { order: 0; }\\n.item-5 { order: 0; }`;\r\n        }\r\n    </script>\r\n</body>\r\n</html>",
