    "htmlContent": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Flexbox Order Property Explained</title>\r\n    <style>\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\r\n        }\r\n        \r\n        body {\r\n            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);\r\n            color: #333;\r\n            min-height: 100vh;\r\n            padding: 20px;\r\n        }\r\n        \r\n        .container {\r\n            max-width: 1200px;\r\n            margin: 0 auto;\r\n            padding: 20px;\r\n        }\r\n        \r\n        header {\r\n            text-align: center;\r\n            padding: 30px;\r\n            background: rgba(255, 255, 255, 0.9);\r\n            border-radius: 15px;\r\n            margin-bottom: 30px;\r\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);\r\n        }\r\n        \r\n        h1 {\r\n            font-size: 2.8rem;\r\n            margin-bottom: 15px;\r\n            color: #2575fc;\r\n            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);\r\n        }\r\n        \r\n        h2 {\r\n            font-size: 1.8rem;\r\n            margin: 25px 0 15px;\r\n            color: #6a11cb;\r\n        }\r\n        \r\n        p {\r\n            font-size: 1.2rem;\r\n            line-height: 1.6;\r\n            margin-bottom: 20px;\r\n        }\r\n        \r\n        .content {\r\n            display: flex;\r\n            gap: 30px;\r\n            margin-top: 30px;\r\n        }\r\n        \r\n        .explanation {\r\n            flex: 1;\r\n            background: rgba(255, 255, 255, 0.9);\r\n            padding: 30px;\r\n            border-radius: 15px;\r\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\r\n        }\r\n        \r\n        .demo {\r\n            flex: 1;\r\n            background: rgba(255, 255, 255, 0.9);\r\n            padding: 30px;\r\n            border-radius: 15px;\r\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\r\n        }\r\n        \r\n        .flex-container {\r\n            display: flex;\r\n            gap: 10px;\r\n            margin: 20px 0;\r\n            padding: 15px;\r\n            background: #f1f8ff;\r\n            border-radius: 10px;\r\n            min-height: 200px;\r\n        }\r\n        \r\n        .item {\r\n            padding: 20px;\r\n            border-radius: 8px;\r\n            text-align: center;\r\n            font-weight: bold;\r\n            flex: 1;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n        }\r\n        \r\n        .item-1 {\r\n            background: #ff6b6b;\r\n        }\r\n        \r\n        .item-2 {\r\n            background: #4ecdc4;\r\n        }\r\n        \r\n        .item-3 {\r\n            background: #ffd166;\r\n        }\r\n        \r\n        .item-4 {\r\n            background: #6a0572;\r\n            color: white;\r\n        }\r\n        \r\n        .item-5 {\r\n            background: #06d6a0;\r\n        }\r\n        \r\n        .controls {\r\n            display: grid;\r\n            grid-template-columns: repeat(2, 1fr);\r\n            gap: 15px;\r\n            margin-top: 20px;\r\n        }\r\n        \r\n        button {\r\n            padding: 12px;\r\n            border: none;\r\n            border-radius: 8px;\r\n            background: #6a11cb;\r\n            color: white;\r\n            font-size: 1rem;\r\n            cursor: pointer;\r\n            transition: all 0.3s ease;\r\n        }\r\n        \r\n        button:hover {\r\n            background: #2575fc;\r\n            transform: translateY(-2px);\r\n        }\r\n        \r\n        .code-example {\r\n            background: #2d2d2d;\r\n            color: #f8f8f2;\r\n            padding: 20px;\r\n            border-radius: 10px;\r\n            margin: 20px 0;\r\n            font-family: monospace;\r\n            overflow-x: auto;\r\n            line-height: 1.5;\r\n            font-size: 1rem;\r\n        }\r\n        \r\n        .key-points {\r\n            background: #e9f5ff;\r\n            padding: 20px;\r\n            border-radius: 10px;\r\n            margin: 20px 0;\r\n        }\r\n        \r\n        ul {\r\n            margin-left: 20px;\r\n            margin-bottom: 20px;\r\n        }\r\n        \r\n        li {\r\n            margin-bottom: 10px;\r\n            line-height: 1.5;\r\n        }\r\n        \r\n        footer {\r\n            text-align: center;\r\n            padding: 30px;\r\n            margin-top: 50px;\r\n            background: rgba(255, 255, 255, 0.9);\r\n            border-radius: 15px;\r\n        }\r\n        \r\n        @media (max-width: 900px) {\r\n            .content {\r\n                flex-direction: column;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"container\">\r\n        <header>\r\n            <h1>Flexbox Order Property</h1>\r\n            <p>Control the visual order of flex items without changing the HTML structure</p>\r\n        </header>\r\n        \r\n        <div class=\"content\">\r\n            <div class=\"explanation\">\r\n                <h2>Do you need to specify order for all items?</h2>\r\n                <p><strong>No, you don't need to specify order for all flex items.</strong> The order property only needs to be applied to items you want to reposition.</p>\r\n                \r\n                <div class=\"key-points\">\r\n                    <h3>Key Points:</h3>\r\n                    <ul>\r\n                        <li>All flex items have a default order value of <strong>0</strong></li>\r\n                        <li>Items with the same order value appear in the source order</li>\r\n                        <li>Items with lower order values appear first</li>\r\n                        <li>Items with higher order values appear later</li>\r\n                        <li>You can use negative values for order</li>\r\n                    </ul>\r\n                </div>\r\n                \r\n                <div class=\"code-example\">\r\n                    /* Default order for all items is 0 */<br>\r\n                    .item-1 { order: 2; }  /* Appears third */<br>\r\n                    .item-2 { order: 1; }  /* Appears second */<br>\r\n                    .item-3 { order: 0; }  /* Appears first (default) */<br>\r\n                    .item-4 { order: -1; } /* Appears before even default */\r\n                </div>\r\n                \r\n                <p>In the example to the right, try applying different order values to see how they affect the layout without needing to specify order for every item.</p>\r\n            </div>\r\n            \r\n            <div class=\"demo\">\r\n                <h2>Interactive Demo</h2>\r\n                <p>Try these order presets or create your own custom order:</p>\r\n                \r\n                <div class=\"flex-container\" id=\"flexContainer\">\r\n                    <div class=\"item item-1\">Item 1 (order: 0)</div>\r\n                    <div class=\"item item-2\">Item 2 (order: 0)</div>\r\n                    <div class=\"item item-3\">Item 3 (order: 0)</div>\r\n                    <div class=\"item item-4\">Item 4 (order: 0)</div>\r\n                    <div class=\"item item-5\">Item 5 (order: 0)</div>\r\n                </div>\r\n                \r\n                <div class=\"controls\">\r\n                    <button onclick=\"applyOrder(1)\">Move Item 1 to End</button>\r\n                    <button onclick=\"applyOrder(2)\">Move Item 5 to Start</button>\r\n                    <button onclick=\"applyOrder(3)\">Reverse Order</button>\r\n                    <button onclick=\"applyOrder(4)\">Custom Order</button>\r\n                    <button onclick=\"resetOrder()\">Reset All Orders</button>\r\n                </div>\r\n                \r\n                <div class=\"code-example\" id=\"codeOutput\">\r\n                    /* Current order values */\r\n                    .item-1 { order: 0; }\r\n                    .item-2 { order: 0; }\r\n                    .item-3 { order: 0; }\r\n                    .item-4 { order: 0; }\r\n                    .item-5 { order: 0; }\r\n                </div>\r\n            </div>\r\n        </div>\r\n        \r\n        <footer>\r\n            <p>Flexbox Order Property Demo &copy; 2023</p>\r\n        </footer>\r\n    </div>\r\n\r\n    <script>\r\n        function applyOrder(preset) {\r\n            const items = document.querySelectorAll('.item');\r\n            const codeOutput = document.getElementById('codeOutput');\r\n            \r\n            switch(preset) {\r\n                case 1: // Move Item 1 to End\r\n                    items[0].style.order = '5';\r\n                    items[0].textContent = 'Item 1 (order: 5)';\r\n                    updateCodeOutput();\r\n                    break;\r\n                    \r\n                case 2: // Move Item 5 to Start\r\n                    items[4].style.order = '-1';\r\n                    items[4].textContent = 'Item 5 (order: -1)';\r\n                    updateCodeOutput();\r\n                    break;\r\n                    \r\n                case 3: // Reverse Order\r\n                    items[0].style.order = '5';\r\n                    items[1].style.order = '4';\r\n                    items[2].style.order = '3';\r\n                    items[3].style.order = '2';\r\n                    items[4].style.order = '1';\r\n                    \r\n                    items[0].textContent = 'Item 1 (order: 5)';\r\n                    items[1].textContent = 'Item 2 (order: 4)';\r\n                    items[2].textContent = 'Item 3 (order: 3)';\r\n                    items[3].textContent = 'Item 4 (order: 2)';\r\n                    items[4].textContent = 'Item 5 (order: 1)';\r\n                    \r\n                    updateCodeOutput();\r\n                    break;\r\n                    \r\n                case 4: // Custom Order\r\n                    items[0].style.order = '3';\r\n                    items[1].style.order = '1';\r\n                    items[2].style.order = '4';\r\n                    items[3].style.order = '2';\r\n                    items[4].style.order = '5';\r\n                    \r\n                    items[0].textContent = 'Item 1 (order: 3)';\r\n                    items[1].textContent = 'Item 2 (order: 1)';\r\n                    items[2].textContent = 'Item 3 (order: 4)';\r\n                    items[3].textContent = 'Item 4 (order: 2)';\r\n                    items[4].textContent = 'Item 5 (order: 5)';\r\n                    \r\n                    updateCodeOutput();\r\n                    break;\r\n            }\r\n            \r\n            function updateCodeOutput() {\r\n                let codeText = '/* Current order values */\\n';\r\n                items.forEach((item, index) => {\r\n                    const orderValue = item.style.order || '0';\r\n                    codeText += `.item-${index+1} { order: ${orderValue}; }\\n`;\r\n                });\r\n                codeOutput.textContent = codeText;\r\n            }\r\n        }\r\n        \r\n        function resetOrder() {\r\n            const items = document.querySelectorAll('.item');\r\n            const codeOutput = document.getElementById('codeOutput');\r\n            \r\n            items.forEach((item, index) => {\r\n                item.style.order = '0';\r\n                item.textContent = `Item ${index+1} (order: 0)`;\r\n            });\r\n            \r\n            codeOutput.textContent = `/* Current order values */\\n.item-1 { order: 0; }\\n.item-2 { order: 0; }\\n.item-3 { order: 0; }\\n.item-4 { order: 0; }\\n.item-5 { order: 0; }`;\r\n        }\r\n    </script>\r\n</body>\r\n</html>",
    "createdAt": "2025-09-13T16:23:36.690Z"
