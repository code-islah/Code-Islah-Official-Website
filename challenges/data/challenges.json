    "htmlContent": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Window Scrolling Demo</title>\r\n    <style>\r\n        * {\r\n            margin: 0;\r\n            padding: 0;\r\n            box-sizing: border-box;\r\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\r\n        }\r\n        \r\n        body {\r\n            background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);\r\n            color: #fff;\r\n            min-height: 200vh;\r\n            padding: 20px;\r\n        }\r\n        \r\n        .container {\r\n            max-width: 1000px;\r\n            margin: 0 auto;\r\n            padding: 20px;\r\n        }\r\n        \r\n        header {\r\n            text-align: center;\r\n            padding: 40px 20px;\r\n            background: rgba(0, 0, 0, 0.3);\r\n            border-radius: 15px;\r\n            margin-bottom: 30px;\r\n            backdrop-filter: blur(10px);\r\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);\r\n        }\r\n        \r\n        h1 {\r\n            font-size: 2.8rem;\r\n            margin-bottom: 15px;\r\n            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);\r\n        }\r\n        \r\n        p {\r\n            font-size: 1.2rem;\r\n            line-height: 1.6;\r\n            margin-bottom: 20px;\r\n        }\r\n        \r\n        .scroll-section {\r\n            display: flex;\r\n            flex-direction: column;\r\n            gap: 20px;\r\n            background: rgba(255, 255, 255, 0.1);\r\n            padding: 30px;\r\n            border-radius: 15px;\r\n            margin-bottom: 40px;\r\n            backdrop-filter: blur(5px);\r\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\r\n        }\r\n        \r\n        .controls {\r\n            display: grid;\r\n            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\r\n            gap: 15px;\r\n            margin-bottom: 20px;\r\n        }\r\n        \r\n        button {\r\n            padding: 15px;\r\n            border: none;\r\n            border-radius: 8px;\r\n            background: rgba(255, 255, 255, 0.2);\r\n            color: white;\r\n            font-size: 1.1rem;\r\n            cursor: pointer;\r\n            transition: all 0.3s ease;\r\n            backdrop-filter: blur(5px);\r\n            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\r\n        }\r\n        \r\n        button:hover {\r\n            background: rgba(255, 255, 255, 0.3);\r\n            transform: translateY(-2px);\r\n            box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);\r\n        }\r\n        \r\n        .input-control {\r\n            display: flex;\r\n            flex-direction: column;\r\n            gap: 10px;\r\n            margin: 20px 0;\r\n        }\r\n        \r\n        input {\r\n            padding: 15px;\r\n            border: none;\r\n            border-radius: 8px;\r\n            background: rgba(255, 255, 255, 0.1);\r\n            color: white;\r\n            font-size: 1.1rem;\r\n            backdrop-filter: blur(5px);\r\n        }\r\n        \r\n        input:focus {\r\n            outline: 2px solid rgba(255, 255, 255, 0.5);\r\n        }\r\n        \r\n        .info-box {\r\n            background: rgba(0, 0, 0, 0.2);\r\n            padding: 20px;\r\n            border-radius: 10px;\r\n            margin-top: 20px;\r\n        }\r\n        \r\n        .position-indicator {\r\n            position: fixed;\r\n            bottom: 20px;\r\n            right: 20px;\r\n            background: rgba(0, 0, 0, 0.6);\r\n            color: white;\r\n            padding: 15px;\r\n            border-radius: 10px;\r\n            font-size: 1.1rem;\r\n            backdrop-filter: blur(5px);\r\n        }\r\n        \r\n        .content-blocks {\r\n            display: flex;\r\n            flex-direction: column;\r\n            gap: 30px;\r\n            margin-top: 40px;\r\n        }\r\n        \r\n        .block {\r\n            background: rgba(255, 255, 255, 0.1);\r\n            padding: 30px;\r\n            border-radius: 15px;\r\n            min-height: 300px;\r\n            backdrop-filter: blur(5px);\r\n        }\r\n        \r\n        .block h2 {\r\n            margin-bottom: 20px;\r\n            font-size: 2rem;\r\n        }\r\n        \r\n        .code-example {\r\n            background: rgba(0, 0, 0, 0.2);\r\n            padding: 20px;\r\n            border-radius: 10px;\r\n            margin: 20px 0;\r\n            font-family: monospace;\r\n            overflow-x: auto;\r\n            line-height: 1.5;\r\n        }\r\n        \r\n        footer {\r\n            text-align: center;\r\n            padding: 30px;\r\n            margin-top: 50px;\r\n            background: rgba(0, 0, 0, 0.3);\r\n            border-radius: 15px;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"container\">\r\n        <header>\r\n            <h1>Window Scrolling with JavaScript</h1>\r\n            <p>Learn how to control window scrolling using scrollY, scrollBy, scrollTo, and scrollIntoView</p>\r\n        </header>\r\n        \r\n        <section class=\"scroll-section\">\r\n            <h2>Scroll Controls</h2>\r\n            \r\n            <div class=\"controls\">\r\n                <button onclick=\"scrollByAmount(100)\">Scroll Down 100px</button>\r\n                <button onclick=\"scrollByAmount(-100)\">Scroll Up 100px</button>\r\n                <button onclick=\"scrollToTop()\">Scroll to Top</button>\r\n                <button onclick=\"scrollToBottom()\">Scroll to Bottom</button>\r\n            </div>\r\n            \r\n            <div class=\"input-control\">\r\n                <label for=\"scrollAmount\">Custom Scroll Amount (px):</label>\r\n                <input type=\"number\" id=\"scrollAmount\" placeholder=\"Enter pixels to scroll\" value=\"300\">\r\n                <button onclick=\"scrollCustomAmount()\">Scroll by Custom Amount</button>\r\n            </div>\r\n            \r\n            <div class=\"input-control\">\r\n                <label for=\"scrollPosition\">Scroll to Position (px):</label>\r\n                <input type=\"number\" id=\"scrollPosition\" placeholder=\"Enter target position\">\r\n                <button onclick=\"scrollToPosition()\">Scroll to Position</button>\r\n            </div>\r\n            \r\n            <div class=\"info-box\">\r\n                <h3>Current Scroll Position: <span id=\"currentScroll\">0</span>px</h3>\r\n                <p>Try the different scrolling methods and watch this value change.</p>\r\n            </div>\r\n        </section>\r\n        \r\n        <section class=\"content-blocks\">\r\n            <div class=\"block\" id=\"section1\">\r\n                <h2>Section 1</h2>\r\n                <p>This is the first content section. Use the scroll buttons to navigate around the page.</p>\r\n                <button onclick=\"scrollToElement('section2')\">Scroll to Section 2</button>\r\n            </div>\r\n            \r\n            <div class=\"block\" id=\"section2\">\r\n                <h2>Section 2</h2>\r\n                <p>This is the second content section. Notice how the scroll position changes when you use the buttons.</p>\r\n                <button onclick=\"scrollToElement('section3')\">Scroll to Section 3</button>\r\n            </div>\r\n            \r\n            <div class=\"block\" id=\"section3\">\r\n                <h2>Section 3</h2>\r\n                <p>This is the third content section. You can scroll to specific elements using their ID.</p>\r\n                <button onclick=\"scrollToElement('section1')\">Scroll to Section 1</button>\r\n            </div>\r\n        </section>\r\n        \r\n        <section class=\"scroll-section\">\r\n            <h2>JavaScript Methods</h2>\r\n            \r\n            <div class=\"code-example\">\r\n                <p>// Scroll by a specific amount</p>\r\n                <p>window.scrollBy(0, 100); // Scrolls down 100px</p>\r\n                <p>window.scrollBy(0, -100); // Scrolls up 100px</p>\r\n                <br>\r\n                <p>// Scroll to a specific position</p>\r\n                <p>window.scrollTo(0, 500); // Scrolls to 500px from top</p>\r\n                <br>\r\n                <p>// Scroll to an element</p>\r\n                <p>document.getElementById('elementId').scrollIntoView();</p>\r\n                <br>\r\n                <p>// Get current scroll position</p>\r\n                <p>const currentPosition = window.scrollY;</p>\r\n            </div>\r\n        </section>\r\n        \r\n        <footer>\r\n            <p>Window Scrolling Demo &copy; 2023</p>\r\n        </footer>\r\n    </div>\r\n    \r\n    <div class=\"position-indicator\">\r\n        Current ScrollY: <span id=\"scrollYPosition\">0</span>px\r\n    </div>\r\n\r\n    <script>\r\n        // Update scroll position indicators\r\n        function updateScrollPosition() {\r\n            document.getElementById('currentScroll').textContent = Math.round(window.scrollY);\r\n            document.getElementById('scrollYPosition').textContent = Math.round(window.scrollY);\r\n        }\r\n        \r\n        // Scroll by a specific amount\r\n        function scrollByAmount(amount) {\r\n            window.scrollBy({\r\n                top: amount,\r\n                left: 0,\r\n                behavior: 'smooth'\r\n            });\r\n        }\r\n        \r\n        // Scroll to top of page\r\n        function scrollToTop() {\r\n            window.scrollTo({\r\n                top: 0,\r\n                left: 0,\r\n                behavior: 'smooth'\r\n            });\r\n        }\r\n        \r\n        // Scroll to bottom of page\r\n        function scrollToBottom() {\r\n            window.scrollTo({\r\n                top: document.body.scrollHeight,\r\n                left: 0,\r\n                behavior: 'smooth'\r\n            });\r\n        }\r\n        \r\n        // Scroll by custom amount from input\r\n        function scrollCustomAmount() {\r\n            const amount = parseInt(document.getElementById('scrollAmount').value) || 0;\r\n            scrollByAmount(amount);\r\n        }\r\n        \r\n        // Scroll to specific position\r\n        function scrollToPosition() {\r\n            const position = parseInt(document.getElementById('scrollPosition').value) || 0;\r\n            window.scrollTo({\r\n                top: position,\r\n                left: 0,\r\n                behavior: 'smooth'\r\n            });\r\n        }\r\n        \r\n        // Scroll to a specific element\r\n        function scrollToElement(elementId) {\r\n            document.getElementById(elementId).scrollIntoView({\r\n                behavior: 'smooth'\r\n            });\r\n        }\r\n        \r\n        // Update scroll position on scroll and load\r\n        window.addEventListener('scroll', updateScrollPosition);\r\n        window.addEventListener('load', updateScrollPosition);\r\n    </script>\r\n</body>\r\n</html>",
    "createdAt": "2025-09-13T16:51:55.306Z"
  }
