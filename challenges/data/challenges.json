mo {\r\n            flex: 1;\r\n            background: rgba(255, 255, 255, 0.9);\r\n            padding: 30px;\r\n            border-radius: 15px;\r\n            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);\r\n        }\r\n        \r\n        .flex-container {\r\n            display: flex;\r\n            gap: 10px;\r\n            margin: 20px 0;\r\n            padding: 15px;\r\n            background: #f1f8ff;\r\n            border-radius: 10px;\r\n            min-height: 200px;\r\n        }\r\n        \r\n        .item {\r\n            padding: 20px;\r\n            border-radius: 8px;\r\n            text-align: center;\r\n            font-weight: bold;\r\n            flex: 1;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n        }\r\n        \r\n        .item-1 {\r\n            background: #ff6b6b;\r\n        }\r\n        \r\n        .item-2 {\r\n            background: #4ecdc4;\r\n        }\r\n        \r\n        .item-3 {\r\n            background: #ffd166;\r\n        }\r\n        \r\n        .item-4 {\r\n            background: #6a0572;\r\n            color: white;\r\n        }\r\n        \r\n        .item-5 {\r\n            background: #06d6a0;\r\n        }\r\n        \r\n        .controls {\r\n            display: grid;\r\n            grid-template-columns: repeat(2, 1fr);\r\n            gap: 15px;\r\n            margin-top: 20px;\r\n        }\r\n        \r\n        button {\r\n            padding: 12px;\r\n            border: none;\r\n            border-radius: 8px;\r\n            background: #6a11cb;\r\n            color: white;\r\n            font-size: 1rem;\r\n            cursor: pointer;\r\n            transition: all 0.3s ease;\r\n        }\r\n        \r\n        button:hover {\r\n            background: #2575fc;\r\n            transform: translateY(-2px);\r\n        }\r\n        \r\n        .code-example {\r\n            background: #2d2d2d;\r\n            color: #f8f8f2;\r\n            padding: 20px;\r\n            border-radius: 10px;\r\n            margin: 20px 0;\r\n            font-family: monospace;\r\n            overflow-x: auto;\r\n            line-height: 1.5;\r\n            font-size: 1rem;\r\n        }\r\n        \r\n        .key-points {\r\n            background: #e9f5ff;\r\n            padding: 20px;\r\n            border-radius: 10px;\r\n            margin: 20px 0;\r\n        }\r\n        \r\n        ul {\r\n            margin-left: 20px;\r\n            margin-bottom: 20px;\r\n        }\r\n        \r\n        li {\r\n            margin-bottom: 10px;\r\n            line-height: 1.5;\r\n        }\r\n        \r\n        footer {\r\n            text-align: center;\r\n            padding: 30px;\r\n            margin-top: 50px;\r\n            background: rgba(255, 255, 255, 0.9);\r\n            border-radius: 15px;\r\n        }\r\n        \r\n        @media (max-width: 900px) {\r\n            .content {\r\n                flex-direction: column;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"container\">\r\n        <header>\r\n            <h1>Flexbox Order Property</h1>\r\n            <p>Control the visual order of flex items without changing the HTML structure</p>\r\n        </header>\r\n        \r\n        <div class=\"content\">\r\n            <div class=\"explanation\">\r\n                <h2>Do you need to specify order for all items?</h2>\r\n                <p><strong>No, you don't need to specify order for all flex items.</strong> The order property only needs to be applied to items you want to reposition.</p>\r\n                \r\n                <div class=\"key-points\">\r\n                    <h3>Key Points:</h3>\r\n                    <ul>\r\n                        <li>All flex items have a default order value of <strong>0</strong></li>\r\n                        <li>Items with the same order value appear in the source order</li>\r\n                        <li>Items with lower order values